@model BulkingPro.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Recuperar Senha - BulkingPro</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Rajdhani', sans-serif;
            background: #060606;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .bg-scene {
            position: fixed;
            inset: 0;
            z-index: 0;
        }

        .bg-lines {
            position: absolute;
            inset: 0;
            background-image: repeating-linear-gradient(
                -55deg,
                transparent,
                transparent 40px,
                rgba(255,255,255,0.012) 40px,
                rgba(255,255,255,0.012) 41px
            );
        }

        .bg-vignette {
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 60% at 50% 50%, transparent 40%, rgba(0,0,0,0.85) 100%),
                radial-gradient(ellipse 60% 80% at 0% 50%, rgba(180,10,15,0.15) 0%, transparent 60%),
                radial-gradient(ellipse 60% 80% at 100% 50%, rgba(180,10,15,0.15) 0%, transparent 60%);
        }

        .bg-topbar {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, #ee1920 30%, #ee1920 70%, transparent);
        }

        .card {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 440px;
            margin: 20px;
            background: rgba(12, 12, 12, 0.92);
            border: 1px solid rgba(255,255,255,0.06);
            border-top: 2px solid #ee1920;
            border-radius: 4px;
            padding: 40px 36px 32px;
            backdrop-filter: blur(12px);
            box-shadow: 0 0 0 1px rgba(238,25,32,0.08), 0 40px 80px rgba(0,0,0,0.7);
        }

        .card::before,
        .card::after {
            content: '';
            position: absolute;
            width: 12px;
            height: 12px;
            border-color: #ee1920;
            border-style: solid;
        }
        .card::before {
            bottom: -1px;
            left: -1px;
            border-width: 0 0 2px 2px;
            border-radius: 0 0 0 4px;
        }
        .card::after {
            bottom: -1px;
            right: -1px;
            border-width: 0 2px 2px 0;
            border-radius: 0 0 4px 0;
        }

        .logo-area {
            text-align: center;
            margin-bottom: 28px;
        }
        .logo-area img {
            height: 90px;
            width: auto;
        }

        .form-title {
            text-align: center;
            margin-bottom: 24px;
        }
        .form-title h1 {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 28px;
            letter-spacing: 3px;
            color: #f0ece8;
        }
        .form-title h1 span {
            color: #ee1920;
        }
        .form-title p {
            font-size: 13px;
            font-weight: 500;
            color: #484240;
            letter-spacing: 0.5px;
            margin-top: 6px;
        }

        .divider-line {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
        }
        .divider-line::before,
        .divider-line::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #1a1a1a;
        }
        .divider-line span {
            font-size: 10px;
            color: #2e2a28;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            color: #5a5250;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .input-wrap {
            position: relative;
        }

        .input-wrap svg {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #2e2a28;
            pointer-events: none;
            transition: color 0.2s;
        }

        .form-control {
            width: 100%;
            background: #0d0d0d;
            border: 1px solid #1c1c1c;
            border-radius: 3px;
            padding: 13px 16px 13px 44px;
            color: #d8d0c8;
            font-family: 'Rajdhani', sans-serif;
            font-size: 15px;
            font-weight: 500;
            letter-spacing: 0.5px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-control:focus {
            outline: none;
            border-color: rgba(238, 25, 32, 0.6);
            box-shadow: 0 0 0 3px rgba(238, 25, 32, 0.08);
        }

        .form-control:focus + svg {
            color: #ee1920;
        }

        .form-control::placeholder {
            color: #252220;
        }

        .alert {
            padding: 12px 16px;
            border-radius: 3px;
            font-size: 13px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .alert-success {
            background: rgba(46, 160, 67, 0.12);
            color: #2ea043;
            border: 1px solid rgba(46, 160, 67, 0.2);
        }

        .alert-danger {
            background: rgba(238, 25, 32, 0.07);
            color: #ff5055;
            border: 1px solid rgba(238, 25, 32, 0.2);
        }

        .btn {
            width: 100%;
            background: #ee1920;
            color: #fff;
            border: none;
            border-radius: 3px;
            padding: 15px;
            font-family: 'Bebas Neue', sans-serif;
            font-size: 18px;
            letter-spacing: 4px;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
            box-shadow: 0 4px 24px rgba(238, 25, 32, 0.4);
        }

        .btn:hover {
            background: #f52028;
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(238, 25, 32, 0.55);
        }

        .btn-ghost {
            background: transparent;
            color: rgba(255,255,255,0.4);
            box-shadow: none;
            font-size: 13px;
            letter-spacing: 1px;
            padding: 10px;
            margin-top: 8px;
        }

        .btn-ghost:hover {
            background: rgba(255,255,255,0.05);
            box-shadow: none;
            transform: none;
        }

        .field-validation-error {
            font-size: 12px;
            color: #ee1920;
            margin-top: 4px;
            display: block;
        }

        .card-footer {
            margin-top: 20px;
            text-align: center;
            font-size: 12px;
            color: #2e2a28;
        }

        .card-footer a {
            color: #5a5250;
            text-decoration: none;
            transition: color 0.2s;
        }

        .card-footer a:hover {
            color: #ee1920;
        }

        @@media (max-width: 480px) {
            .card { padding: 28px 20px; }
            .form-title h1 { font-size: 22px; }
            .logo-area img { height: 70px; }
        }
    </style>
</head>

<body>
    <div class="bg-scene">
        <div class="bg-lines"></div>
        <div class="bg-vignette"></div>
        <div class="bg-topbar"></div>
    </div>

    <div class="card">
        <div class="logo-area">
            <img src="~/img/Logo_sem_fundo.png" alt="BulkingPro" />
        </div>

        <div class="form-title">
            <h1>RECUPERAR <span>SENHA</span></h1>
            <p>Enviaremos um código para seu e-mail</p>
        </div>

        <div class="divider-line"><span>Recuperação</span></div>

        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success">
                <i class="ti ti-circle-check"></i> @TempData["Sucesso"]
            </div>
        }

        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-danger">
                <i class="ti ti-alert-circle"></i> @TempData["Erro"]
            </div>
        }

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Email">E-mail</label>
                <div class="input-wrap">
                    <input type="email" class="form-control" asp-for="Email" placeholder="seu@email.com" required />
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                    </svg>
                </div>
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn">Enviar Código</button>
        </form>

        <div class="card-footer">
            <a asp-controller="Account" asp-action="Login">← Voltar para o login</a>
        </div>
    </div>

    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
</body>
</html>