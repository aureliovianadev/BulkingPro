@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <title>BulkingPro - Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Rajdhani', sans-serif;
            background: #060606;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        /* ── Fundo com textura diagonal ── */
        .bg-scene {
            position: fixed;
            inset: 0;
            z-index: 0;
        }

        /* Linhas diagonais estilo placa metálica */
        .bg-lines {
            position: absolute;
            inset: 0;
            background-image: repeating-linear-gradient(
                -55deg,
                transparent,
                transparent 40px,
                rgba(255,255,255,0.012) 40px,
                rgba(255,255,255,0.012) 41px
            );
        }

        /* Vinheta lateral vermelha */
        .bg-vignette {
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 60% at 50% 50%, transparent 40%, rgba(0,0,0,0.85) 100%),
                radial-gradient(ellipse 60% 80% at 0% 50%, rgba(180,10,15,0.15) 0%, transparent 60%),
                radial-gradient(ellipse 60% 80% at 100% 50%, rgba(180,10,15,0.15) 0%, transparent 60%);
        }

        /* Faixa vermelha no topo */
        .bg-topbar {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, #ee1920 30%, #ee1920 70%, transparent);
        }

        /* ── Card principal ── */
        .card {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 440px;
            margin: 20px;
            background: rgba(12, 12, 12, 0.92);
            border: 1px solid rgba(255,255,255,0.06);
            border-top: 2px solid #ee1920;
            border-radius: 4px;
            padding: 48px 44px 40px;
            backdrop-filter: blur(12px);
            box-shadow:
                0 0 0 1px rgba(238,25,32,0.08),
                0 40px 80px rgba(0,0,0,0.7),
                0 0 60px rgba(238,25,32,0.05);
        }

        /* Cantos decorativos */
        .card::before,
        .card::after {
            content: '';
            position: absolute;
            width: 12px;
            height: 12px;
            border-color: #ee1920;
            border-style: solid;
        }
        .card::before {
            bottom: -1px;
            left: -1px;
            border-width: 0 0 2px 2px;
            border-radius: 0 0 0 4px;
        }
        .card::after {
            bottom: -1px;
            right: -1px;
            border-width: 0 2px 2px 0;
            border-radius: 0 0 4px 0;
        }

        /* ── Logo area ── */
        .logo-area {
            text-align: center;
            margin-bottom: 36px;
        }
        .logo-area img {
            height: 130px;
            width: auto;
        }

        /* ── Título ── */
        .form-title {
            text-align: center;
            margin-bottom: 32px;
        }
        .form-title h1 {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 42px;
            letter-spacing: 4px;
            color: #f0ece8;
            line-height: 1;
        }
        .form-title h1 span {
            color: #ee1920;
        }
        .form-title p {
            font-size: 13px;
            font-weight: 500;
            color: #484240;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-top: 8px;
        }

        /* ── Divisor ── */
        .divider-line {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 28px;
        }
        .divider-line::before,
        .divider-line::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #1a1a1a;
        }
        .divider-line span {
            font-size: 10px;
            color: #2e2a28;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        /* ── Form ── */
        .login-form {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .input-group label {
            font-size: 11px;
            font-weight: 700;
            color: #5a5250;
            letter-spacing: 2.5px;
            text-transform: uppercase;
        }

        .input-wrap {
            position: relative;
        }

        .input-wrap svg {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #2e2a28;
            pointer-events: none;
            transition: color 0.2s;
        }

        .input-group input {
            width: 100%;
            background: #0d0d0d;
            border: 1px solid #1c1c1c;
            border-radius: 3px;
            padding: 13px 16px 13px 44px;
            color: #d8d0c8;
            font-family: 'Rajdhani', sans-serif;
            font-size: 15px;
            font-weight: 500;
            letter-spacing: 0.5px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .input-group input:focus {
            outline: none;
            border-color: rgba(238, 25, 32, 0.6);
            box-shadow: 0 0 0 3px rgba(238, 25, 32, 0.08), inset 0 0 20px rgba(238, 25, 32, 0.03);
        }

        .input-group input:focus + svg,
        .input-group input:focus ~ svg {
            color: #ee1920;
        }

        .input-group input::placeholder {
            color: #252220;
        }

        /* ── Botão toggle senha ── */
        .btn-toggle-senha {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.15);
            cursor: pointer;
            padding: 4px 6px;
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s ease;
            z-index: 2;
            border-radius: 4px;
            line-height: 1;
        }

        .btn-toggle-senha:hover {
            color: rgba(255, 255, 255, 0.5);
        }

        .btn-toggle-senha:focus {
            outline: none;
            color: #ee1920;
        }

        .btn-toggle-senha i {
            font-size: 18px;
            pointer-events: none;
        }

        .input-group input:focus ~ .btn-toggle-senha {
            color: rgba(238, 25, 32, 0.4);
        }

        /* Ícone após input (workaround para ordem no DOM) */
        .input-wrap input:focus ~ svg {
            color: rgba(238,25,32,0.5);
        }

        /* ── Esqueci senha ── */
        .row-forgot {
            display: flex;
            justify-content: flex-end;
            margin-top: -8px;
        }
        .row-forgot a {
            font-size: 11px;
            font-weight: 600;
            color: #3a3530;
            text-decoration: none;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            transition: color 0.2s;
        }
        .row-forgot a:hover { color: #ee1920; }

        /* ── Erro ── */
        .erro-msg {
            background: rgba(238, 25, 32, 0.07);
            border: 1px solid rgba(238, 25, 32, 0.2);
            border-left: 3px solid #ee1920;
            border-radius: 3px;
            padding: 10px 14px;
            color: #ff5055;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        /* ── Botão ── */
        .btn-login {
            position: relative;
            width: 100%;
            background: #ee1920;
            color: #fff;
            border: none;
            border-radius: 3px;
            padding: 15px;
            font-family: 'Bebas Neue', sans-serif;
            font-size: 20px;
            letter-spacing: 5px;
            cursor: pointer;
            overflow: hidden;
            margin-top: 6px;
            transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
            box-shadow: 0 4px 24px rgba(238, 25, 32, 0.4), inset 0 1px 0 rgba(255,255,255,0.1);
        }

        .btn-login::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(105deg, transparent 35%, rgba(255,255,255,0.12) 50%, transparent 65%);
            transform: translateX(-100%);
            transition: transform 0.55s ease;
        }

        .btn-login:hover {
            background: #f52028;
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(238, 25, 32, 0.55);
        }

        .btn-login:hover::after { transform: translateX(100%); }
        .btn-login:active { transform: translateY(0); }

        /* ── Rodapé do card ── */
        .card-footer {
            margin-top: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .footer-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 600;
            color: #2e2a28;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .footer-badge svg {
            color: #ee1920;
            opacity: 0.6;
        }

        .footer-sep {
            width: 3px;
            height: 3px;
            border-radius: 50%;
            background: #1e1e1e;
        }

        /* ── Link Esqueceu a senha ── */
        .link-forgot-password {
            text-align: center;
            margin-top: 2px;
        }
        .link-forgot-password a {
            font-size: 12px;
            font-weight: 600;
            color: #5a5250;
            text-decoration: none;
            letter-spacing: 0.5px;
            transition: color 0.2s;
        }
        .link-forgot-password a:hover {
            color: #ee1920;
        }
    </style>
</head>

<body>

    <div class="bg-scene">
        <div class="bg-lines"></div>
        <div class="bg-vignette"></div>
        <div class="bg-topbar"></div>
    </div>

    <div class="card">

        <div class="logo-area">
            <img src="~/img/Logo_sem_fundo.png" alt="BulkingPro" />
        </div>

        <div class="form-title">
            <h1>ACESSE <span>SUA</span> CONTA</h1>
            <p>Plataforma de treino profissional</p>
        </div>

        <div class="divider-line"><span>Login</span></div>

        <form asp-controller="Account" asp-action="Login" method="post" class="login-form">
            @Html.AntiForgeryToken()

            @if (ViewBag.Erro != null)
            {
                <div class="erro-msg">@ViewBag.Erro</div>
            }

            <div class="input-group">
                <label>E-mail</label>
                <div class="input-wrap">
                    <input type="email" name="email" placeholder="seu@email.com" required />
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                    </svg>
                </div>
            </div>

            <div class="input-group">
                <label>Senha</label>
                <div class="input-wrap">
                    <input type="password" name="senha" id="senhaLogin" placeholder="••••••••" required />
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    <button type="button" class="btn-toggle-senha" data-target="senhaLogin" aria-label="Mostrar ou ocultar senha">
                        <i class="ti ti-eye"></i>
                    </button>
                </div>
            </div>

            <div class="link-forgot-password">
                <a asp-controller="PasswordReset" asp-action="ForgotPassword">Esqueceu sua senha?</a>
            </div>

            <button type="submit" class="btn-login">Entrar</button>

        </form>

        <div class="card-footer">
            <div class="footer-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                Acesso seguro
            </div>
            <div class="footer-sep"></div>
            <div class="footer-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
                24h disponível
            </div>
        </div>

    </div>

    <!-- ─── SCRIPT PARA MOSTRAR/OCULTAR SENHA ─── -->
    <script>
        (function() {
            'use strict';

            function toggleSenha(button) {
                var targetId = button.getAttribute('data-target');
                if (!targetId) return;

                var input = document.getElementById(targetId);
                if (!input) return;

                var icon = button.querySelector('i');
                if (!icon) return;

                var isPassword = input.type === 'password';

                input.type = isPassword ? 'text' : 'password';

                if (isPassword) {
                    icon.className = 'ti ti-eye';
                } else {
                    icon.className = 'ti ti-eye-off';
                }

                input.focus();
                event.preventDefault();
            }

            function initToggleSenha() {
                var buttons = document.querySelectorAll('.btn-toggle-senha');
                buttons.forEach(function(button) {
                    button.removeEventListener('click', toggleSenhaHandler);
                    button.addEventListener('click', toggleSenhaHandler);
                });
            }

            function toggleSenhaHandler(event) {
                event.preventDefault();
                var button = event.currentTarget;
                toggleSenha(button);
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initToggleSenha);
            } else {
                initToggleSenha();
            }

        })();
    </script>

</body>

</html>
