</style>

<script>
    var dadosAgendamentos = {};

    @{
        var jsData = new System.Text.StringBuilder();
        foreach (var dia in Model.Dias)
        {
            foreach (var ag in dia.Agendamentos)
            {
                jsData.Append($"dadosAgendamentos['{ag.AlunoId}'] = {{");
                jsData.Append($"nome: '{ag.AlunoNome}',");
                jsData.Append($"iniciais: '{ag.Iniciais}',");
                jsData.Append($"objetivo: '{(ag.Objetivo ?? "Sem objetivo definido")}',");
                jsData.Append($"horario: '{ag.HoraInicio.ToString(@"hh\:mm")} - {ag.HoraFim.ToString(@"hh\:mm")}',");
                jsData.Append($"treinoDia: '{(ag.TreinoDiaNome ?? "Treino do dia")}',");
                jsData.Append($"planoId: '{(ag.PlanoTreinoId.HasValue ? ag.PlanoTreinoId.Value.ToString() : "")}',");
                jsData.Append("exercicios: [");

                var exercicios = ag.Exercicios;
                for (int i = 0; i < exercicios.Count; i++)
                {
                    var ex = exercicios[i];
                    jsData.Append("{");
                    jsData.Append($"nome: '{ex.Nome.Replace("'", "\\'")}',");
                    jsData.Append($"grupo: '{ex.GrupoMuscular.Replace("'", "\\'")}',");
                    jsData.Append($"series: {ex.Series},");
                    jsData.Append($"repsTempo: '{ex.RepeticoesOuTempo.Replace("'", "\\'")}',");
                    jsData.Append($"carga: {(ex.Carga.HasValue ? ex.Carga.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null")},");
                    jsData.Append($"descanso: {(ex.Descanso.HasValue ? ex.Descanso.Value.ToString() : "null")},");
                    jsData.Append($"obs: '{(ex.Observacoes?.Replace("'", "\\'") ?? "")}'");
                    jsData.Append("}");
                    if (i < exercicios.Count - 1) jsData.Append(",");
                }

                jsData.Append("]");
                jsData.Append("};");
            }
        }
    }

    @Html.Raw(jsData.ToString())

    function abrirModal(elemento) {
        var alunoId = elemento.dataset.alunoId;
        var dados = dadosAgendamentos[alunoId];

        if (!dados) {
            console.error('Dados não encontrados para aluno:', alunoId);
            return;
        }

        document.getElementById('modalAvatar').textContent = dados.iniciais;
        document.getElementById('modalNome').textContent = dados.nome;
        document.getElementById('modalHorario').textContent = dados.horario;
        document.getElementById('modalObjetivo').textContent = dados.objetivo;
        document.getElementById('modalTreinoDia').textContent = dados.treinoDia;

        var btnPlano = document.getElementById('modalBtnPlano');
        if (dados.planoId && dados.planoId !== '') {
            btnPlano.href = '/Personal/VisualizarPlano/' + dados.planoId;
            btnPlano.style.display = 'inline-flex';
        } else {
            btnPlano.style.display = 'none';
        }

        var container = document.getElementById('modalExercicios');

        if (dados.exercicios && dados.exercicios.length > 0) {
            var html = '';
            dados.exercicios.forEach(function(ex, index) {
                var detalhes = [];
                if (ex.series) detalhes.push(ex.series + ' séries');
                if (ex.repsTempo) {
                    if (ex.repsTempo.includes('min') || ex.repsTempo.includes('s')) {
                        detalhes.push('⏱ ' + ex.repsTempo);
                    } else {
                        detalhes.push('🔄 ' + ex.repsTempo + ' reps');
                    }
                }
                if (ex.carga) detalhes.push('🏋️ ' + ex.carga + ' kg');
                if (ex.descanso) detalhes.push('⏳ ' + ex.descanso + 's');

                html += `
                    <div class="modal-exercicio-item">
                        <div class="modal-exercicio-bullet">${index + 1}</div>
                        <div class="modal-exercicio-info">
                            <div class="modal-exercicio-nome">${ex.nome}</div>
                            <div class="modal-exercicio-grupo">${ex.grupo || '—'}</div>
                            <div class="modal-exercicio-detalhes">
                                ${detalhes.map(d => `<span class="modal-exercicio-chip">${d}</span>`).join('')}
                            </div>
                            ${ex.obs ? `<div style="font-size:10px;color:rgba(255,255,255,0.3);margin-top:2px">📝 ${ex.obs}</div>` : ''}
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
        } else {
            container.innerHTML = `
                <div class="sem-treino-msg">
                    <i class="ti ti-barbell-off"></i>
                    <span>Nenhum treino cadastrado para este dia</span>
                </div>
            `;
        }

        document.getElementById('modalAgendamento').style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function fecharModal() {
        document.getElementById('modalAgendamento').style.display = 'none';
        document.body.style.overflow = '';
    }

    document.getElementById('modalAgendamento').addEventListener('click', function(e) {
        if (e.target === this) fecharModal();
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            if (document.getElementById('modalAgendamento').style.display === 'flex') fecharModal();
            if (document.getElementById('modalCalendarioVisual').style.display === 'flex') fecharCalendarioVisual();
        }
    });

    // ═══════════════════════════════════════════════════════════════════
    // CALENDÁRIO VISUAL COM SELEÇÃO DE ANO INFINITA (INPUT + SETAS)
    // ═══════════════════════════════════════════════════════════════════

    var dataCalendarioVisual = new Date();
    var dataSelecionadaCalendarioVisual = null;
    var diasComAgendamentoVisual = [];

    function abrirCalendarioVisual() {
        var modal = document.getElementById('modalCalendarioVisual');
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        
        dataSelecionadaCalendarioVisual = null;
        
        // Atualiza input de ano
        document.getElementById('calendarioInputAno').value = dataCalendarioVisual.getFullYear();
        document.getElementById('calendarioSelectMes').value = dataCalendarioVisual.getMonth();
        
        carregarDiasComAgendamentoVisual();
        renderizarCalendarioVisual();
    }

    function fecharCalendarioVisual() {
        document.getElementById('modalCalendarioVisual').style.display = 'none';
        document.body.style.overflow = '';
    }

    function carregarDiasComAgendamentoVisual() {
        diasComAgendamentoVisual = [];
        var mesAtual = dataCalendarioVisual.getMonth();
        var anoAtual = dataCalendarioVisual.getFullYear();
        
        var agendamentosNaSemana = document.querySelectorAll('.agendamento-card');
        agendamentosNaSemana.forEach(function(card) {
            var dataStr = card.dataset.dia;
            if (dataStr) {
                var partes = dataStr.split('-');
                var data = new Date(parseInt(partes[0]), parseInt(partes[1]) - 1, parseInt(partes[2]));
                if (data.getMonth() === mesAtual && data.getFullYear() === anoAtual) {
                    if (!diasComAgendamentoVisual.includes(data.getDate())) {
                        diasComAgendamentoVisual.push(data.getDate());
                    }
                }
            }
        });
    }

    function renderizarCalendarioVisual() {
        var ano = dataCalendarioVisual.getFullYear();
        var mes = dataCalendarioVisual.getMonth();
        var hoje = new Date();
        var hojeDia = hoje.getDate();
        var hojeMes = hoje.getMonth();
        var hojeAno = hoje.getFullYear();

        var primeiroDia = new Date(ano, mes, 1);
        var diaSemanaInicio = primeiroDia.getDay();

        var ultimoDia = new Date(ano, mes + 1, 0);
        var totalDias = ultimoDia.getDate();

        var diasMesAnterior = new Date(ano, mes, 0).getDate();

        var grid = document.getElementById('calendarioGridVisual');
        grid.innerHTML = '';

        for (var i = diaSemanaInicio - 1; i >= 0; i--) {
            var dia = diasMesAnterior - i;
            var btn = criarDiaCalendarioVisual(dia, true);
            grid.appendChild(btn);
        }

        for (var d = 1; d <= totalDias; d++) {
            var btn = criarDiaCalendarioVisual(d, false);
            
            if (d === hojeDia && mes === hojeMes && ano === hojeAno) {
                btn.classList.add('hoje');
            }
            
            if (diasComAgendamentoVisual.includes(d)) {
                btn.classList.add('tem-agendamento');
            }
            
            grid.appendChild(btn);
        }

        var totalCelulas = diaSemanaInicio + totalDias;
        var diasRestantes = (7 - (totalCelulas % 7)) % 7;
        for (var r = 1; r <= diasRestantes; r++) {
            var btn = criarDiaCalendarioVisual(r, true);
            grid.appendChild(btn);
        }
    }

    function criarDiaCalendarioVisual(dia, isOutroMes) {
        var btn = document.createElement('button');
        btn.className = 'calendario-dia';
        if (isOutroMes) btn.classList.add('outro-mes');
        btn.textContent = dia;
        
        var ano = dataCalendarioVisual.getFullYear();
        var mes = dataCalendarioVisual.getMonth();
        var dataClick = new Date(ano, mes, dia);
        
        btn.addEventListener('click', function() {
            document.querySelectorAll('#calendarioGridVisual .calendario-dia.selecionado').forEach(function(el) {
                el.classList.remove('selecionado');
            });
            this.classList.add('selecionado');
            dataSelecionadaCalendarioVisual = dataClick;
        });
        
        return btn;
    }

    function navegarMesVisual(direcao) {
        dataCalendarioVisual.setMonth(dataCalendarioVisual.getMonth() + direcao);
        atualizarInputsVisual();
        carregarDiasComAgendamentoVisual();
        renderizarCalendarioVisual();
    }

    function navegarAnoVisual(direcao) {
        var anoAtual = parseInt(document.getElementById('calendarioInputAno').value) || dataCalendarioVisual.getFullYear();
        var novoAno = anoAtual + direcao;
        if (novoAno >= 1900 && novoAno <= 2100) {
            irParaAnoVisual(novoAno);
        }
    }

    function irParaAnoVisual(ano) {
        var anoInt = parseInt(ano);
        if (isNaN(anoInt) || anoInt < 1900 || anoInt > 2100) {
            // Restaura o valor atual se for inválido
            document.getElementById('calendarioInputAno').value = dataCalendarioVisual.getFullYear();
            return;
        }
        
        dataCalendarioVisual = new Date(anoInt, dataCalendarioVisual.getMonth(), 1);
        atualizarInputsVisual();
        carregarDiasComAgendamentoVisual();
        renderizarCalendarioVisual();
    }

    function atualizarInputsVisual() {
        document.getElementById('calendarioInputAno').value = dataCalendarioVisual.getFullYear();
        document.getElementById('calendarioSelectMes').value = dataCalendarioVisual.getMonth();
    }

    function atualizarCalendarioVisual() {
        var mes = parseInt(document.getElementById('calendarioSelectMes').value);
        var ano = parseInt(document.getElementById('calendarioInputAno').value);
        
        if (isNaN(ano) || ano < 1900 || ano > 2100) {
            document.getElementById('calendarioInputAno').value = dataCalendarioVisual.getFullYear();
            return;
        }
        
        dataCalendarioVisual = new Date(ano, mes, 1);
        carregarDiasComAgendamentoVisual();
        renderizarCalendarioVisual();
    }

    function confirmarDataVisual() {
        if (!dataSelecionadaCalendarioVisual) {
            var hoje = new Date();
            var ano = dataCalendarioVisual.getFullYear();
            var mes = dataCalendarioVisual.getMonth();
            var dia = dataSelecionadaCalendarioVisual ? dataSelecionadaCalendarioVisual.getDate() : hoje.getDate();
            dataSelecionadaCalendarioVisual = new Date(ano, mes, dia);
        }
        
        var dataStr = dataSelecionadaCalendarioVisual.getFullYear() + '-' + 
                      String(dataSelecionadaCalendarioVisual.getMonth() + 1).padStart(2, '0') + '-' + 
                      String(dataSelecionadaCalendarioVisual.getDate()).padStart(2, '0');
        
        fecharCalendarioVisual();
        window.location.href = '/Personal/Agenda?data=' + dataStr;
    }

    document.getElementById('modalCalendarioVisual').addEventListener('click', function(e) {
        if (e.target === this) fecharCalendarioVisual();
    });

    document.addEventListener('DOMContentLoaded', function() {
        var hoje = new Date();
        dataCalendarioVisual = new Date(hoje.getFullYear(), hoje.getMonth(), 1);
    });

    // ── ENTER NO INPUT DE ANO ──
    document.getElementById('calendarioInputAno').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            irParaAnoVisual(this.value);
        }
    });

    // ── VALIDAÇÃO DO INPUT DE ANO ──
    document.getElementById('calendarioInputAno').addEventListener('blur', function() {
        var val = parseInt(this.value);
        if (isNaN(val) || val < 1900 || val > 2100) {
            this.value = dataCalendarioVisual.getFullYear();
        }
    });

    // ═══════════════════════════════════════════════════════════════════
    // NAVEGAÇÃO
    // ═══════════════════════════════════════════════════════════════════

    function irParaData(dataStr) {
        if (!dataStr) return;
        window.location.href = '/Personal/Agenda?data=' + dataStr;
    }

    function irParaHoje() {
        var hoje = new Date();
        var dataStr = hoje.getFullYear() + '-' + 
                      String(hoje.getMonth() + 1).padStart(2, '0') + '-' + 
                      String(hoje.getDate()).padStart(2, '0');
        window.location.href = '/Personal/Agenda?data=' + dataStr;
    }

    function irParaSemana(direcao) {
        var currentUrl = new URL(window.location.href);
        var dataParam = currentUrl.searchParams.get('data');
        var dataAtual;
        
        if (dataParam) {
            var partes = dataParam.split('-');
            dataAtual = new Date(parseInt(partes[0]), parseInt(partes[1]) - 1, parseInt(partes[2]));
        } else {
            dataAtual = new Date();
        }
        
        dataAtual.setDate(dataAtual.getDate() + (direcao * 7));
        
        var dataStr = dataAtual.getFullYear() + '-' + 
                      String(dataAtual.getMonth() + 1).padStart(2, '0') + '-' + 
                      String(dataAtual.getDate()).padStart(2, '0');
        
        window.location.href = '/Personal/Agenda?data=' + dataStr;
    }
</script>