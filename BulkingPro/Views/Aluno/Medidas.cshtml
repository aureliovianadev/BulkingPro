@model List<BulkingPro.Models.AvaliacaoFisica>
@{
    Layout = "~/Views/Aluno/_AlunoLayout.cshtml";
    ViewData["Title"] = "Minhas Medidas";
    ViewData["ActivePage"] = "Medidas";
}

@section Topbar {
    <div class="topbar">
        <div>
            <div class="topbar-title">Minhas Medidas</div>
            <div class="topbar-sub">Histórico de avaliações físicas</div>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div style="text-align: center; padding: 60px 20px; color: var(--muted);">
        <i class="ti ti-ruler" style="font-size: 48px; margin-bottom: 16px; display: block;"></i>
        <p>Nenhuma avaliação física cadastrada até o momento.</p>
        <p style="font-size: 12px; margin-top: 8px;">Seu personal trainer irá registrar suas medidas em breve.</p>
    </div>
}
else
{
    <!-- Filtra avaliações que têm peso E altura para o gráfico -->
    var avaliacoesComImc = Model.Where(a => a.Peso.HasValue && a.Altura.HasValue && a.Altura > 0).OrderBy(a => a.DataAvaliacao).ToList();

    @if (avaliacoesComImc.Any())
    {
        <!-- Gráfico de IMC -->
        <div class="grafico-container">
            <div class="card-title"><i class="ti ti-chart-line"></i> Evolução do IMC</div>
            <canvas id="imcChart" width="400" height="200"></canvas>
        </div>
    }
    else
    {
        <!-- Mensagem quando não há dados suficientes para o gráfico -->
        <div style="text-align: center; padding: 40px 20px; color: var(--muted); background: var(--bg3); border-radius: 12px; border: 1px solid var(--border); margin-bottom: 20px;">
            <i class="ti ti-chart-bar" style="font-size: 32px; display: block; margin-bottom: 8px; color: rgba(196,168,122,0.3);"></i>
            <p>Não há dados suficientes para exibir o gráfico de IMC.</p>
            <p style="font-size: 12px; margin-top: 4px;">É necessário ter pelo menos uma avaliação com peso e altura preenchidos.</p>
        </div>
    }

    <!-- Lista de avaliações -->
    @foreach (var av in Model)
    {
        decimal? imc = (av.Peso.HasValue && av.Altura.HasValue && av.Altura > 0)
            ? Math.Round(av.Peso.Value / (av.Altura.Value * av.Altura.Value), 2)
            : null;
        
        <div class="card" style="margin-bottom: 16px;">
            <div class="card-body">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <div>
                        <div style="font-size: 16px; font-weight: 600;">@av.DataAvaliacao.ToString("dd/MM/yyyy")</div>
                        @if (imc.HasValue)
                        {
                            <div style="font-size: 12px; color: var(--muted); margin-top: 4px;">IMC: @imc.Value.ToString("F1")</div>
                        }
                        else
                        {
                            <div style="font-size: 12px; color: var(--muted); margin-top: 4px;">IMC: — (dados incompletos)</div>
                        }
                    </div>
                </div>
                
                <div class="medidas-grid">
                    @if (av.Altura.HasValue) { <div class="medida-item"><div class="medida-label">Altura</div><div class="medida-val">@av.Altura.Value.ToString("F2") m</div></div> }
                    @if (av.Peso.HasValue) { <div class="medida-item"><div class="medida-label">Peso</div><div class="medida-val">@av.Peso.Value.ToString("F1") kg</div></div> }
                    @if (av.Pescoco.HasValue) { <div class="medida-item"><div class="medida-label">Pescoço</div><div class="medida-val">@av.Pescoco.Value.ToString("F1") cm</div></div> }
                    @if (av.Ombro.HasValue) { <div class="medida-item"><div class="medida-label">Ombro</div><div class="medida-val">@av.Ombro.Value.ToString("F1") cm</div></div> }
                    @if (av.ToraxContrai.HasValue) { <div class="medida-item"><div class="medida-label">Tórax (cont.)</div><div class="medida-val">@av.ToraxContrai.Value.ToString("F1") cm</div></div> }
                    @if (av.BicepsDireito.HasValue) { <div class="medida-item"><div class="medida-label">Bíceps D</div><div class="medida-val">@av.BicepsDireito.Value.ToString("F1") cm</div></div> }
                    @if (av.BicepsEsquerdo.HasValue) { <div class="medida-item"><div class="medida-label">Bíceps E</div><div class="medida-val">@av.BicepsEsquerdo.Value.ToString("F1") cm</div></div> }
                    @if (av.Cintura.HasValue) { <div class="medida-item"><div class="medida-label">Cintura</div><div class="medida-val">@av.Cintura.Value.ToString("F1") cm</div></div> }
                    @if (av.Quadril.HasValue) { <div class="medida-item"><div class="medida-label">Quadril</div><div class="medida-val">@av.Quadril.Value.ToString("F1") cm</div></div> }
                    @if (av.CoxaDireita.HasValue) { <div class="medida-item"><div class="medida-label">Coxa D</div><div class="medida-val">@av.CoxaDireita.Value.ToString("F1") cm</div></div> }
                    @if (av.PanturrilhaDireita.HasValue) { <div class="medida-item"><div class="medida-label">Panturrilha D</div><div class="medida-val">@av.PanturrilhaDireita.Value.ToString("F1") cm</div></div> }
                </div>
                
                @if (!string.IsNullOrWhiteSpace(av.Observacoes))
                {
                    <div style="margin-top: 12px; padding: 10px 14px; background: rgba(255,255,255,0.03); border-radius: 8px; font-size: 12px; color: var(--muted);">
                        <i class="ti ti-notes"></i> @av.Observacoes
                    </div>
                }
            </div>
        </div>
    }
}

<style>
    .grafico-container {
        background: var(--bg3);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
    }
    
    .card-title {
        font-size: 14px;
        font-weight: 600;
        color: rgba(255,255,255,0.7);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    .card-title i {
        color: var(--gold);
        font-size: 18px;
    }
    
    .medidas-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 10px;
    }
    
    .medida-item {
        background: rgba(255,255,255,0.03);
        border-radius: 8px;
        padding: 8px 12px;
    }
    
    .medida-label {
        font-size: 9px;
        color: rgba(255,255,255,0.3);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 4px;
    }
    
    .medida-val {
        font-size: 14px;
        font-weight: 600;
        color: #fff;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            @{
                var avaliacoesComImc = Model.Where(a => a.Peso.HasValue && a.Altura.HasValue && a.Altura > 0).OrderBy(a => a.DataAvaliacao).ToList();
            }
            
            @if (avaliacoesComImc.Any())
            {
                <text>
                    try {
                        var canvas = document.getElementById('imcChart');
                        if (!canvas) {
                            console.warn('Elemento imcChart não encontrado');
                            return;
                        }

                        var ctx = canvas.getContext('2d');
                        
                        // Prepara os dados
                        var labels = [@Html.Raw(string.Join(", ", avaliacoesComImc.Select(a => $"'{a.DataAvaliacao.ToString("dd/MM/yyyy")}'")))];
                        var dataValues = [@string.Join(", ", avaliacoesComImc.Select(a => 
                            Math.Round(a.Peso.Value / (a.Altura.Value * a.Altura.Value), 2)
                            .ToString(System.Globalization.CultureInfo.InvariantCulture)
                        ))];

                        console.log('📊 Dados do gráfico IMC:', {
                            labels: labels,
                            values: dataValues,
                            totalAvaliacoes: @avaliacoesComImc.Count
                        });

                        // Verifica se os dados são válidos
                        if (dataValues.length === 0) {
                            console.warn('Nenhum dado válido para o gráfico');
                            return;
                        }

                        // Cria o gráfico
                        new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: labels,
                                datasets: [{
                                    label: 'IMC',
                                    data: dataValues,
                                    borderColor: '#c4a87a',
                                    backgroundColor: 'rgba(196,168,122,0.1)',
                                    fill: true,
                                    tension: 0.3,
                                    pointBackgroundColor: '#c4a87a',
                                    pointBorderColor: '#fff',
                                    pointBorderWidth: 1,
                                    pointRadius: 4
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: true,
                                plugins: {
                                    legend: {
                                        labels: {
                                            color: 'rgba(255,255,255,0.6)',
                                            font: {
                                                size: 11
                                            }
                                        }
                                    },
                                    tooltip: {
                                        callbacks: {
                                            label: function(context) {
                                                return 'IMC: ' + context.parsed.y.toFixed(2);
                                            }
                                        }
                                    }
                                },
                                scales: {
                                    y: {
                                        grid: {
                                            color: 'rgba(255,255,255,0.03)'
                                        },
                                        ticks: {
                                            color: 'rgba(255,255,255,0.3)',
                                            font: {
                                                size: 10
                                            }
                                        }
                                    },
                                    x: {
                                        grid: {
                                            color: 'rgba(255,255,255,0.03)'
                                        },
                                        ticks: {
                                            color: 'rgba(255,255,255,0.3)',
                                            font: {
                                                size: 10
                                            }
                                        }
                                    }
                                }
                            }
                        });

                        console.log('✅ Gráfico IMC renderizado com sucesso!');
                    } catch (error) {
                        console.error('❌ Erro ao renderizar gráfico IMC:', error);
                    }
                </text>
            }
        });
    </script>
}