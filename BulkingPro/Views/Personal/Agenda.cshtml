@model BulkingPro.ViewModels.AgendaSemanalViewModel
@{
    Layout = "~/Views/Personal/_PersonalLayout.cshtml";
    ViewData["Title"] = "Minha Agenda";
    ViewData["ActivePage"] = "Agenda";

    var coresAvatar = new[] { "r", "g", "b", "p" };
    var hoje = DateTime.Today;
    var dataSelecionada = Model.DataReferencia;
}

@section Topbar {
    <div class="topbar">
        <div>
            <div class="topbar-title">Minha Agenda</div>
            <div class="topbar-sub">Visualize seus atendimentos da semana</div>
        </div>
        <div class="topbar-actions">
            <div class="nav-semana">
                <button class="btn btn-ghost btn-sm btn-semana" onclick="irParaSemana(-1)">
                    <i class="ti ti-chevron-left"></i>
                </button>
                
                <span class="semana-label" id="semanaLabel">
                    @Model.InicioSemana.ToString("dd/MM/yyyy") - @Model.FimSemana.ToString("dd/MM/yyyy")
                </span>
                
                <button class="btn btn-ghost btn-sm btn-semana" onclick="irParaSemana(1)">
                    <i class="ti ti-chevron-right"></i>
                </button>
                
                <button class="btn btn-ghost btn-sm btn-calendario" onclick="abrirCalendarioVisual()" title="Selecionar data">
                    <i class="ti ti-calendar"></i>
                </button>
                
                <button class="btn btn-ghost btn-sm btn-hoje" onclick="irParaHoje()">
                    <i class="ti ti-calendar-event"></i> Hoje
                </button>
            </div>
        </div>
    </div>
}

@if (dataSelecionada != DateTime.Today)
{
    <div class="data-selecionada-banner">
        <i class="ti ti-calendar-check"></i>
        Visualizando semana de <strong>@Model.InicioSemana.ToString("dd/MM/yyyy")</strong> a <strong>@Model.FimSemana.ToString("dd/MM/yyyy")</strong>
        <button class="btn btn-ghost btn-sm" onclick="irParaHoje()" style="margin-left:12px">
            <i class="ti ti-arrow-back"></i> Voltar para hoje
        </button>
    </div>
}

<div class="resumo-grid">
    <div class="resumo-card">
        <div class="resumo-icon gold"><i class="ti ti-calendar-event"></i></div>
        <div>
            <div class="resumo-valor">@Model.Resumo.TotalAulas</div>
            <div class="resumo-label">Total de aulas</div>
        </div>
    </div>
    <div class="resumo-card">
        <div class="resumo-icon red"><i class="ti ti-clock"></i></div>
        <div>
            <div class="resumo-valor">@Model.Resumo.TotalHoras</div>
            <div class="resumo-label">Horas agendadas</div>
        </div>
    </div>
    <div class="resumo-card">
        <div class="resumo-icon green"><i class="ti ti-arrow-right"></i></div>
        <div>
            <div class="resumo-valor" style="font-size:13px;font-weight:500;color:var(--gold)">
                @Model.Resumo.ProximoAtendimento
            </div>
            <div class="resumo-label">Próximo atendimento</div>
        </div>
    </div>
</div>

<div class="agenda-grid">
    @foreach (var dia in Model.Dias)
    {
        var isHoje = dia.Data.Date == DateTime.Today.Date;
        var isSelecionada = dia.Data.Date == dataSelecionada.Date;
        
        <div class="dia-card @(isHoje ? "hoje" : "") @(isSelecionada ? "selecionada" : "")">
            <div class="dia-header">
                <div class="dia-nome">
                    <span class="dia-nome-completo">@dia.NomeDia</span>
                    <span class="dia-nome-abreviado">@dia.NomeDiaAbreviado</span>
                    @if (isHoje)
                    {
                        <span class="dia-badge-hoje">HOJE</span>
                    }
                    @if (isSelecionada && !isHoje)
                    {
                        <span class="dia-badge-selecionada">SELECIONADA</span>
                    }
                </div>
                <div class="dia-data">@dia.Data.ToString("dd/MM")</div>
                <div class="dia-contagem">
                    @dia.TotalAgendamentos @(dia.TotalAgendamentos == 1 ? "aula" : "aulas")
                </div>
            </div>

            <div class="dia-content">
                @if (!dia.TemAgendamentos)
                {
                    <div class="sem-agendamento">
                        <i class="ti ti-calendar-off"></i>
                        <span>Nenhum atendimento agendado</span>
                    </div>
                }
                else
                {
                    @foreach (var ag in dia.Agendamentos)
                    {
                        var cor = coresAvatar[Math.Abs(ag.AlunoId.GetHashCode()) % coresAvatar.Length];
                        var isProximo = isHoje && ag.HoraInicio > DateTime.Now.TimeOfDay;
                        
                        <div class="agendamento-card @(isProximo ? "proximo" : "")" 
                             data-aluno-id="@ag.AlunoId"
                             data-plano-id="@ag.PlanoTreinoId"
                             data-dia="@dia.Data.ToString("yyyy-MM-dd")"
                             data-nome="@ag.AlunoNome"
                             data-objetivo="@ag.Objetivo"
                             data-iniciais="@ag.Iniciais"
                             data-hora-inicio="@ag.HoraInicio.ToString(@"hh\:mm")"
                             data-hora-fim="@ag.HoraFim.ToString(@"hh\:mm")"
                             data-treino-dia="@ag.TreinoDiaNome"
                             onclick="abrirModal(this)">
                            
                            <div class="agendamento-horario">
                                @ag.HoraInicio.ToString(@"hh\:mm") - @ag.HoraFim.ToString(@"hh\:mm")
                            </div>
                            
                            <div class="agendamento-aluno">
                                <div class="avatar-mini @cor">@ag.Iniciais</div>
                                <div class="agendamento-info">
                                    <div class="agendamento-nome">@ag.AlunoNome</div>
                                    <div class="agendamento-objetivo">@(ag.Objetivo ?? "Sem objetivo definido")</div>
                                </div>
                            </div>
                            
                            <div class="agendamento-status">
                                <span class="status-badge confirmado">
                                    <i class="ti ti-check"></i> @ag.Status
                                </span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

<!-- CALENDÁRIO VISUAL CUSTOMIZADO COM SELEÇÃO DE ANO INFINITA -->
<div id="modalCalendarioVisual" class="modal-overlay" style="display:none">
    <div class="modal-container calendario-container">
        <div class="modal-content calendario-content">
            <div class="calendario-header">
                <div class="calendario-titulo">
                    <i class="ti ti-calendar"></i> Selecionar data
                </div>
                <button class="modal-close" onclick="fecharCalendarioVisual()">
                    <i class="ti ti-x"></i>
                </button>
            </div>

            <div class="calendario-nav">
                <button class="btn-calendario-nav" onclick="navegarMesVisual(-1)">
                    <i class="ti ti-chevron-left"></i>
                </button>
                
                <div class="calendario-nav-center">
                    <select class="calendario-select-mes" id="calendarioSelectMes" onchange="atualizarCalendarioVisual()">
                        <option value="0">Janeiro</option>
                        <option value="1">Fevereiro</option>
                        <option value="2">Março</option>
                        <option value="3">Abril</option>
                        <option value="4">Maio</option>
                        <option value="5">Junho</option>
                        <option value="6">Julho</option>
                        <option value="7">Agosto</option>
                        <option value="8">Setembro</option>
                        <option value="9">Outubro</option>
                        <option value="10">Novembro</option>
                        <option value="11">Dezembro</option>
                    </select>
                    
                    <div class="calendario-ano-wrapper">
                        <input type="number" class="calendario-input-ano" id="calendarioInputAno" 
                               min="1900" max="2100" 
                               onchange="irParaAnoVisual(this.value)"
                               onfocus="this.select()" />
                        <div class="calendario-ano-seta-up" onclick="navegarAnoVisual(1)">▲</div>
                        <div class="calendario-ano-seta-down" onclick="navegarAnoVisual(-1)">▼</div>
                    </div>
                </div>
                
                <button class="btn-calendario-nav" onclick="navegarMesVisual(1)">
                    <i class="ti ti-chevron-right"></i>
                </button>
            </div>

            <div class="calendario-dias-semana">
                <span>DOM</span>
                <span>SEG</span>
                <span>TER</span>
                <span>QUA</span>
                <span>QUI</span>
                <span>SEX</span>
                <span>SÁB</span>
            </div>

            <div class="calendario-grid" id="calendarioGridVisual">
            </div>

            <div class="calendario-atalhos">
                <button class="btn btn-ghost btn-sm" onclick="irParaHoje(); fecharCalendarioVisual();">
                    <i class="ti ti-calendar-event"></i> Hoje
                </button>
                <button class="btn btn-ghost btn-sm" onclick="irParaSemana(-1); fecharCalendarioVisual();">
                    <i class="ti ti-arrow-left"></i> Semana passada
                </button>
                <button class="btn btn-ghost btn-sm" onclick="irParaSemana(1); fecharCalendarioVisual();">
                    <i class="ti ti-arrow-right"></i> Próxima semana
                </button>
                <button class="btn btn-ghost btn-sm" onclick="fecharCalendarioVisual()">
                    <i class="ti ti-x"></i> Fechar
                </button>
            </div>

            <div class="calendario-footer">
                <button class="btn btn-primary" id="btnConfirmarDataVisual" onclick="confirmarDataVisual()">
                    <i class="ti ti-check"></i> Ir para data
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL AGENDAMENTO -->
<div id="modalAgendamento" class="modal-overlay" style="display:none">
    <div class="modal-container">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-header-left">
                    <div class="modal-avatar" id="modalAvatar">J</div>
                    <div>
                        <div class="modal-nome" id="modalNome">João Silva</div>
                        <div class="modal-horario" id="modalHorario">08:00 - 09:30</div>
                    </div>
                </div>
                <div class="modal-header-right">
                    <span class="status-badge confirmado" id="modalStatus">
                        <i class="ti ti-check"></i> Confirmado
                    </span>
                    <button class="modal-close" onclick="fecharModal()">
                        <i class="ti ti-x"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                <div class="modal-info-row">
                    <span class="modal-info-label">Objetivo</span>
                    <span class="modal-info-value" id="modalObjetivo">Hipertrofia</span>
                </div>
                <div class="modal-info-row">
                    <span class="modal-info-label">Treino do dia</span>
                    <span class="modal-info-value" id="modalTreinoDia">Treino A</span>
                </div>

                <div class="modal-divider"></div>

                <div class="modal-exercicios">
                    <div class="modal-exercicios-titulo">
                        <i class="ti ti-barbell"></i> Exercícios
                    </div>
                    <div id="modalExercicios"></div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-ghost" onclick="fecharModal()">Fechar</button>
                <a class="btn btn-primary" id="modalBtnPlano" href="#">
                    <i class="ti ti-eye"></i> Ver plano completo
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .resumo-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 28px;
    }

    .resumo-card {
        background: var(--bg3);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 18px 22px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: border-color .2s;
    }

    .resumo-card:hover {
        border-color: rgba(238, 25, 32, 0.3);
    }

    .resumo-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .resumo-icon.gold {
        background: rgba(196, 168, 122, 0.15);
        color: var(--gold);
    }
    .resumo-icon.red {
        background: rgba(238, 25, 32, 0.15);
        color: var(--red);
    }
    .resumo-icon.green {
        background: rgba(46, 160, 67, 0.15);
        color: #2ea043;
    }

    .resumo-valor {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        line-height: 1.2;
    }

    .resumo-label {
        font-size: 11px;
        color: var(--muted);
        margin-top: 2px;
    }

    .nav-semana {
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 255, 255, 0.03);
        padding: 4px 8px;
        border-radius: 30px;
        border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .btn-semana {
        padding: 4px 10px;
        border-radius: 20px;
        min-width: 32px;
        justify-content: center;
    }

    .btn-calendario {
        padding: 4px 10px;
        border-radius: 20px;
        color: var(--gold);
        border-color: rgba(196, 168, 122, 0.3);
    }

    .btn-calendario:hover {
        background: rgba(196, 168, 122, 0.1);
    }

    .semana-label {
        font-size: 12px;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.7);
        min-width: 140px;
        text-align: center;
        font-variant-numeric: tabular-nums;
    }

    .btn-hoje {
        padding: 4px 12px;
        border-radius: 20px;
        color: var(--red);
        border-color: rgba(238, 25, 32, 0.3);
    }

    .btn-hoje:hover {
        background: rgba(238, 25, 32, 0.1);
    }

    .data-selecionada-banner {
        background: rgba(196, 168, 122, 0.08);
        border: 1px solid rgba(196, 168, 122, 0.2);
        border-radius: 12px;
        padding: 10px 16px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        color: rgba(255, 255, 255, 0.7);
        font-size: 13px;
    }

    .data-selecionada-banner i {
        color: var(--gold);
        font-size: 18px;
    }

    .data-selecionada-banner strong {
        color: #fff;
    }

    .agenda-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 12px;
    }

    .dia-card {
        background: var(--bg3);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        transition: all .2s ease;
        min-height: 300px;
    }

    .dia-card:hover {
        border-color: rgba(255, 255, 255, 0.15);
    }

    .dia-card.hoje {
        border-color: var(--red);
        box-shadow: 0 0 20px rgba(238, 25, 32, 0.08);
    }

    .dia-card.hoje .dia-header {
        background: rgba(238, 25, 32, 0.06);
    }

    .dia-card.selecionada {
        border-color: var(--gold);
        box-shadow: 0 0 25px rgba(196, 168, 122, 0.15);
    }

    .dia-card.selecionada .dia-header {
        background: rgba(196, 168, 122, 0.08);
    }

    .dia-header {
        padding: 12px 14px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 4px;
    }

    .dia-nome {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .dia-nome-completo {
        font-size: 13px;
        font-weight: 600;
        color: #fff;
    }

    .dia-nome-abreviado {
        display: none;
        font-size: 12px;
        font-weight: 600;
        color: #fff;
    }

    .dia-badge-hoje {
        font-size: 8px;
        font-weight: 700;
        text-transform: uppercase;
        background: var(--red);
        color: #fff;
        padding: 1px 6px;
        border-radius: 20px;
        letter-spacing: 0.5px;
    }

    .dia-badge-selecionada {
        font-size: 8px;
        font-weight: 700;
        text-transform: uppercase;
        background: var(--gold);
        color: #fff;
        padding: 1px 6px;
        border-radius: 20px;
        letter-spacing: 0.5px;
    }

    .dia-data {
        font-size: 11px;
        color: var(--muted);
        font-weight: 500;
    }

    .dia-contagem {
        font-size: 10px;
        color: var(--muted);
        background: rgba(255, 255, 255, 0.05);
        padding: 1px 8px;
        border-radius: 20px;
    }

    .dia-content {
        padding: 10px 12px 14px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-height: 220px;
    }

    .sem-agendamento {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 28px 12px;
        color: var(--muted);
        text-align: center;
        flex: 1;
    }

    .sem-agendamento i {
        font-size: 32px;
        color: rgba(255, 255, 255, 0.08);
        margin-bottom: 8px;
    }

    .sem-agendamento span {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.25);
    }

    .agendamento-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 12px;
        padding: 10px 12px;
        cursor: pointer;
        transition: all .2s ease;
        position: relative;
    }

    .agendamento-card:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(238, 25, 32, 0.3);
        transform: translateY(-1px);
    }

    .agendamento-card.proximo {
        border-color: rgba(196, 168, 122, 0.3);
        background: rgba(196, 168, 122, 0.05);
    }

    .agendamento-horario {
        font-size: 11px;
        font-weight: 600;
        color: var(--gold);
        margin-bottom: 6px;
        font-family: monospace;
        letter-spacing: 0.5px;
    }

    .agendamento-aluno {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .avatar-mini {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        flex-shrink: 0;
        text-transform: uppercase;
    }

    .avatar-mini.r {
        background: rgba(238, 25, 32, 0.2);
        color: var(--red);
    }
    .avatar-mini.g {
        background: rgba(196, 168, 122, 0.2);
        color: var(--gold);
    }
    .avatar-mini.b {
        background: rgba(56, 139, 253, 0.2);
        color: #388bfd;
    }
    .avatar-mini.p {
        background: rgba(160, 80, 200, 0.2);
        color: #a050c8;
    }

    .agendamento-info {
        flex: 1;
        min-width: 0;
    }

    .agendamento-nome {
        font-size: 12px;
        font-weight: 600;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .agendamento-objetivo {
        font-size: 10px;
        color: var(--muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .agendamento-status {
        margin-top: 6px;
        display: flex;
        justify-content: flex-end;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 9px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 20px;
        letter-spacing: 0.3px;
    }

    .status-badge.confirmado {
        background: rgba(46, 160, 67, 0.12);
        color: #2ea043;
        border: 1px solid rgba(46, 160, 67, 0.15);
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(8px);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: fadeIn .25s ease;
    }

    .modal-container {
        width: 100%;
        max-width: 540px;
        margin: 20px;
        animation: slideUp .3s ease;
    }

    .modal-content {
        background: var(--bg2);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
    }

    .modal-header {
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        background: rgba(255, 255, 255, 0.02);
    }

    .modal-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
        flex: 1;
        min-width: 0;
    }

    .modal-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: rgba(196, 168, 122, 0.2);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        font-weight: 700;
        flex-shrink: 0;
        text-transform: uppercase;
    }

    .modal-nome {
        font-size: 16px;
        font-weight: 700;
        color: #fff;
    }

    .modal-horario {
        font-size: 12px;
        color: var(--gold);
        font-family: monospace;
        margin-top: 2px;
    }

    .modal-header-right {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    .modal-close {
        background: rgba(255, 255, 255, 0.06);
        border: none;
        color: var(--muted);
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 18px;
        transition: all .2s;
    }

    .modal-close:hover {
        background: rgba(238, 25, 32, 0.15);
        color: var(--red);
    }

    .modal-body {
        padding: 20px 24px;
    }

    .modal-info-row {
        display: flex;
        justify-content: space-between;
        padding: 6px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .modal-info-row:last-of-type {
        border-bottom: none;
    }

    .modal-info-label {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.35);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .modal-info-value {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.85);
        font-weight: 500;
        text-align: right;
        max-width: 60%;
    }

    .modal-divider {
        margin: 16px 0;
